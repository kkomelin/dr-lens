{
  "manifest_version": 3,
  "name": "DR Lens — Domain Rating in your toolbar",
  "version": "1.0.1",
  "description": "Shows the Ahrefs Domain Rating of the site you're on, drawn right into the toolbar icon. Free, no API key.",
  "minimum_chrome_version": "103",
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "DR Lens",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["tabs", "storage", "alarms"],
  "host_permissions": ["https://api.ahrefs.com/*"]
}
